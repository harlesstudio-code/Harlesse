# Konfigurasi Lokal Harles Studio
# Jangan bagikan file .env asli atau commit ke Git!

PORT=3456

# Mode default:
# - personal : API Key & Target ID bisa dibaca/simpan di .env (khusus 127.0.0.1 PC pribadi)
# - shared   : Mode BYOK (Bring Your Own Key) — .env dikunci; setiap user isi API Key di browsernya
APP_MODE=personal

# Roblox Open Cloud API Key (buat di Creator Dashboard -> Open Cloud -> API Keys)
# Berikan izin minimal: Assets (Read & Write)
ROBLOX_API_KEY=

# Target Creator Default: "user" (akun pribadi) atau "group"
ROBLOX_DEFAULT_TARGET=user

# Isi salah satu atau keduanya (angka ID saja)
ROBLOX_USER_ID=
ROBLOX_GROUP_ID=
